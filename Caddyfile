# Medo API gateway — explicit public-route table (Map 3 t05, ticket 31).
# Unlisted paths => 404. Internal/service-JWT routes are never proxied:
# inter-service calls go container-to-container, not through Caddy.
# Env: MEDO_API_HOST (site address), MEDO_ALLOWED_ORIGIN (CORS), ACME_EMAIL.
{
	email {$ACME_EMAIL:admin@simmaps.com}
}

{$MEDO_API_HOST:api.simmaps.com} {
	# --- CORS (single allowed origin; credentials for refresh cookie) ---
	@preflight {
		method OPTIONS
		path /v1/*
	}
	handle @preflight {
		header Access-Control-Allow-Origin {$MEDO_ALLOWED_ORIGIN:https://app.simmaps.com}
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		header Vary "Origin"
		respond 204
	}

	# response-level CORS for actual requests
	@browser header Origin *
	header @browser Access-Control-Allow-Origin {$MEDO_ALLOWED_ORIGIN:https://app.simmaps.com}
	header @browser Access-Control-Allow-Credentials "true"
	header @browser Vary "Origin"

	# --- Identity ---
	@identity path /v1/auth/* /v1/me
	handle @identity {
		reverse_proxy identity:3001
	}

	# --- Care (public invites/links only; check-link + patients/* stay internal) ---
	@care path /v1/care/invites /v1/care/invites/* /v1/care/links /v1/care/links/*
	handle @care {
		reverse_proxy care:3002
	}

	# --- Medicine (catalog + patient medicines; /v1/medicines/{id} is dual-authz) ---
	@medicine path /v1/medicine-catalog /v1/medicine-catalog/* /v1/medicines /v1/medicines/*
	handle @medicine {
		reverse_proxy medicine:3003
	}

	# --- Schedule & Dose ---
	@schedules path /v1/schedules/*
	handle @schedules {
		reverse_proxy schedule-dose:3004
	}
	@dose_outcome {
		path /v1/doses/*
		not path /v1/doses/due
	}
	handle @dose_outcome {
		reverse_proxy schedule-dose:3004
	}
	@patient_sd path /v1/patients/*/schedules /v1/patients/*/doses
	handle @patient_sd {
		reverse_proxy schedule-dose:3004
	}

	# --- Gamification ---
	@gamification path /v1/patients/*/gamification
	handle @gamification {
		reverse_proxy gamification:3006
	}

	# --- Notification ---
	@notification path /v1/notifications /v1/notifications/* /v1/notification-preferences /v1/push/vapid-key /v1/push-subscriptions /v1/push-subscriptions/*
	handle @notification {
		reverse_proxy notification:3005
	}

	# --- Public liveness (UptimeRobot); /ready /metrics /jwks stay internal ---
	@health path /health
	handle @health {
		reverse_proxy identity:3001
	}

	# everything else: explicit 404
	handle {
		respond 404
	}
}
