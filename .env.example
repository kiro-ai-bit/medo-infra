# Medo Infra env — GENERATED by scripts/gen-env.py, never hand-edit, never commit.
# This file documents the variable surface only.

# --- shared (.env, compose interpolation) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<from .secrets/db-passwords.json>
POSTGRES_DB=postgres
IDENTITY_DB_PASSWORD=<from .secrets/db-passwords.json>
CARE_DB_PASSWORD=<from .secrets/db-passwords.json>
MEDICINE_DB_PASSWORD=<from .secrets/db-passwords.json>
SCHEDULE_DOSE_DB_PASSWORD=<from .secrets/db-passwords.json>
NOTIFICATION_DB_PASSWORD=<from .secrets/db-passwords.json>
GAMIFICATION_DB_PASSWORD=<from .secrets/db-passwords.json>
BROKER_DB_PASSWORD=<from .secrets/db-passwords.json>
# image tags — managed by scripts/release.sh (sha-<short12> of each repo HEAD)
MEDO_TAG_IDENTITY=latest
MEDO_TAG_CARE=latest
MEDO_TAG_MEDICINE=latest
MEDO_TAG_SCHEDULE_DOSE=latest
MEDO_TAG_NOTIFICATION=latest
MEDO_TAG_GAMIFICATION=latest
ACME_EMAIL=admin@simmaps.com

# --- per-service (secrets/<env>/<svc>.env, generated) ---
# DATABASE_URL / BROKER_DATABASE_URL  postgres://<role>:<pw>@postgres:5432/<db>_db
# SERVICE_PRIVATE_KEY / SERVICE_PUBLIC_KEYS  ES256 JWKs from .secrets/medo-<env>-keys.json
# IDENTITY_JWKS_URL + peer *_URL/_BASE_URL    container DNS (http://<svc>:300x)
# identity: JWT_PRIVATE_KEY / JWT_PUBLIC_KEYS / APP_BASE_URL / CARE_SERVICE_URL
# care: INVITE_TOKEN_SECRET / INVITE_LINK_BASE
# medicine: R2_* (passthrough from service .env)
# notification: VAPID_* / RESEND_API_KEY / EMAIL_FROM / PUSH_ENDPOINT_ALLOWLIST
